# Production environment example for Restaurant POS
# Placeholder values in this file are intentionally invalid for production.
# Copy this file to .env.production, replace every placeholder, and never commit real secrets.
# SERVER_NAME must match the production DNS name and certificate directory under /etc/letsencrypt/live/.
# PUBLIC_BASE_URL should be the public HTTPS origin after TLS is enabled.
# CORS_ORIGINS must list exact allowed browser origins; never use "*".
# DEFAULT_ADMIN_PASSWORD is required for first startup/bootstrap seeding; use a strong unique value.
# Real secrets must come from a secure operator workflow or secret manager, never from source control.
# Optional registry deploy variables should be set by the operator shell or host service manager.
# Do not store registry credentials in this file; run docker login on the host instead.
# For a Cloudflare deployment, keep the tunnel token in the ignored
# .secrets/cloudflare-tunnel-token file and use scripts/deploy-production-cloudflare.sh.

SERVER_NAME=restaurant.example.com
PUBLIC_BASE_URL=https://restaurant.example.com
# Temporary IP-only pilot escape hatch. Keep unset or false for normal production.
# Set to true only before DNS/SSL is ready, then remove after enabling HTTPS.
# ALLOW_HTTP_PUBLIC_BASE_URL_FOR_PILOT=false
POSTGRES_DB=restaurant_pos_db
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=enter_secure_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://restaurant_user:enter_secure_password_here@postgres:5432/restaurant_pos_db
# Keep legacy mode until the Platform/Restaurant databases have been created,
# migrated, reconciled and backed up. Platform canary additionally requires
# PLATFORM_DATABASE_URL, RESTAURANT_DATABASE_URL and REFERENCE_PROJECTOR_ENABLED=true.
IDENTITY_DATABASE=legacy
RESTAURANT_SERVICE_DATABASE=legacy
REFERENCE_PROJECTOR_ENABLED=false
REFERENCE_PROJECTOR_POLL_SECONDS=1
REFERENCE_PROJECTOR_BATCH_SIZE=100
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace_with_secure_random_hex_string
DEFAULT_ADMIN_PASSWORD=replace_with_strong_unique_default_admin_password
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
OFFLINE_SALE_AUTHORIZATION_EXPIRE_HOURS=12
ENVIRONMENT=production
CORS_ORIGINS=["https://restaurant.example.com"]
APP_NAME=Restaurant POS
APP_VERSION=1.0.0
ENABLE_API_DOCS=false
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_EXTENSIONS=[".jpg",".jpeg",".png",".webp"]
ALLOWED_UPLOAD_MIME_TYPES=["image/jpeg","image/png","image/webp"]

# Production account verification and password-reset email must use SMTP.
# UAT may point these values at an isolated mail catcher; production must use
# the approved provider/relay and a real sender domain.
SAAS_PUBLIC_BASE_URL=https://restaurant.example.com
SAAS_EMAIL_DELIVERY_MODE=smtp
SAAS_SMTP_HOST=smtp.example.com
SAAS_SMTP_PORT=587
SAAS_SMTP_USERNAME=
SAAS_SMTP_PASSWORD=
SAAS_SMTP_FROM_EMAIL=no-reply@restaurant.example.com
SAAS_SMTP_FROM_NAME=Restaurant SaaS
SAAS_SMTP_USE_TLS=false
SAAS_SMTP_START_TLS=true

# Optional registry pull mode for immutable images published by CI:
# PRODUCTION_IMAGE_MODE=pull
# IMAGE_REGISTRY=ghcr.io
# IMAGE_NAMESPACE=owner/repository
