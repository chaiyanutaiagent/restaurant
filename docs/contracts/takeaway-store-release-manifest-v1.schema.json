{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foodchainservice.com/contracts/takeaway-store-release-manifest-v1.schema.json",
  "title": "Foodchainservice Takeaway Store signed Android release",
  "type": "object",
  "additionalProperties": false,
  "required": ["surface", "channel", "package_id", "version_name", "version_code", "minimum_supported_version_code", "rollback_version_code", "apk_url", "apk_sha256", "published_at", "signature"],
  "properties": {
    "surface": { "const": "takeaway_store" },
    "channel": { "enum": ["uat", "production"] },
    "package_id": { "enum": ["com.foodchainservice.takeaway", "com.foodchainservice.takeaway.uat"] },
    "version_name": { "type": "string", "minLength": 1 },
    "version_code": { "type": "integer", "minimum": 1 },
    "minimum_supported_version_code": { "type": "integer", "minimum": 1 },
    "rollback_version_code": { "type": ["integer", "null"], "minimum": 1 },
    "apk_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "apk_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "published_at": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "minLength": 40 }
  }
}
