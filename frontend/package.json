{
  "name": "restaurant-pos-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev:pos": "vite --config vite.mobile-pos.config.ts --mode pos-uat",
    "build:pos:uat": "vite build --config vite.mobile-pos.config.ts --mode pos-uat && node ../scripts/check-mobile-pos-bundle.mjs",
    "pos:android:sync": "npm run build:pos:uat && CAPACITOR_APP=pos-uat cap sync android",
    "pos:ios:sync": "npm run build:pos:uat && CAPACITOR_APP=pos-uat cap sync ios",
    "pos:android:open": "CAPACITOR_APP=pos-uat cap open android",
    "pos:ios:open": "CAPACITOR_APP=pos-uat cap open ios",
    "pos:android:apk": "npm run pos:android:sync && cd android-pos && ./gradlew assembleDebug",
    "pos:release": "node -e \"throw new Error('POS Production release is on HOLD pending platform and device gates')\"",
    "e2e:pos-native": "playwright test --config=playwright.mobile-pos.config.ts",
    "dev": "vite",
    "build": "vite build",
    "build:android": "npm run build:android:uat",
    "build:mobile-store": "vite build --mode android-uat --config vite.mobile-store.config.ts",
    "build:android:uat": "npm run build:mobile-store && node ../scripts/check-mobile-store-bundle.mjs dist-mobile-store && CAPACITOR_UAT=true cap sync android",
    "android:apk": "npm run build:android && cd android && ./gradlew assembleDebug",
    "android:apk:uat": "npm run build:android:uat && cd android && ./gradlew assembleDebug",
    "android:test": "cd android && ./gradlew testDebugUnitTest lintDebug",
    "android:apk:release": "node -e \"throw new Error('Production Android release is on HOLD; use android:apk:uat')\"",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "e2e:p5": "playwright test --config=playwright.config.ts",
    "e2e:platform": "playwright test --config=playwright.platform.config.ts",
    "e2e:company": "playwright test --config=playwright.company.config.ts",
    "e2e:kitchen": "playwright test --config=playwright.company-kitchen.config.ts",
    "e2e:distribution": "playwright test --config=playwright.company-distribution.config.ts",
    "e2e:takeaway": "playwright test --config=playwright.takeaway.config.ts",
    "e2e:public": "playwright test --config=playwright.public.config.ts",
    "e2e:integration": "playwright test --config=playwright.integration.config.ts",
    "e2e:retail": "playwright test --config=playwright.retail.config.ts",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "7.6.8",
    "@capacitor/network": "^7.0.4",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.35.1",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "axios": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^3.2.7",
    "immer": "^11.1.8",
    "lucide-react": "^1.14.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.18.3",
    "react-to-print": "^3.2.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.12.12",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-pwa": "^0.20.0",
    "workbox-window": "^7.1.0"
  }
}
