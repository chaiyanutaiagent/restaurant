{
  "name": "restaurant-pos-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "CI_DISABLE_PWA=true vite build --mode android && cap sync android",
    "build:android:uat": "CI_DISABLE_PWA=true vite build --mode android-uat && CAPACITOR_UAT=true cap sync android",
    "android:apk": "npm run build:android && cd android && ./gradlew assembleDebug",
    "android:apk:uat": "npm run build:android:uat && cd android && ./gradlew assembleDebug",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "e2e:p5": "playwright test --config=playwright.config.ts",
    "e2e:platform": "playwright test --config=playwright.platform.config.ts",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/network": "^7.0.4",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.35.1",
    "axios": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^3.2.7",
    "immer": "^11.1.8",
    "lucide-react": "^1.14.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.18.1",
    "react-to-print": "^3.2.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.6.0",
