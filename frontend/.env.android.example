# Copy this file to .env.android after the production domain and HTTPS are ready.
# One APK serves every customer; do not hard-code a Company ID or business slug here.
# Do not add /api/v1; the app adds that path automatically.
VITE_API_BASE_URL=https://takeaway.foodchainservice.com
VITE_PUBLIC_APP_ORIGIN=https://takeaway.foodchainservice.com
VITE_UAT_AUTO_LOGIN=false
VITE_TAKEAWAY_RELEASE_MANIFEST_URL=https://downloads.foodchainservice.com/takeaway/production/latest.json
VITE_TAKEAWAY_RELEASE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_ED25519_PUBLIC_KEY\n-----END PUBLIC KEY-----"
