# Copy this file to .env.android-uat for a local tablet UAT build.
# Use a Mac address reachable by the tablet, preferably its stable Tailscale IP.
# Do not add /api/v1; the app adds that path automatically.
VITE_API_BASE_URL=http://100.x.y.z:8081
VITE_COMPANY_ID=1b8a1818-44d6-4d5f-9d22-e5e17b23c081
VITE_TAKEAWAY_RELEASE_MANIFEST_URL=https://downloads.foodchainservice.com/takeaway/uat/latest.json
VITE_TAKEAWAY_RELEASE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_ED25519_PUBLIC_KEY\n-----END PUBLIC KEY-----"
