# Copy this file to .env.android-uat for a controlled tablet UAT build.
# Do not add /api/v1; the app adds that path automatically.
VITE_API_BASE_URL=https://uat-takeaway.foodchainservice.com
VITE_PUBLIC_APP_ORIGIN=https://uat-takeaway.foodchainservice.com
VITE_UAT_AUTO_LOGIN=false
VITE_TAKEAWAY_STORE_RELEASE_MANIFEST_URL=https://uat-takeaway.foodchainservice.com/downloads/takeaway-store/latest.json
VITE_TAKEAWAY_STORE_RELEASE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_ED25519_PUBLIC_KEY\n-----END PUBLIC KEY-----"
VITE_TAKEAWAY_STORE_RELEASE_CHANNEL=uat
VITE_TAKEAWAY_STORE_PACKAGE_ID=com.foodchainservice.takeaway.uat
