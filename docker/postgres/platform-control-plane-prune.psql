DO $$
DECLARE
    candidate record;
BEGIN
    FOR candidate IN
        SELECT tablename
        FROM pg_tables
        WHERE schemaname = 'public'
          AND tablename NOT IN (
              'companies',
              'brands',
              'branches',
              'brand_branches',
              'users',
              'roles',
              'permissions',
              'role_permissions',
              'user_branches',
              'refresh_tokens',
              'user_access_requests',
              'user_invitations',
              'audit_logs',
              'legacy_alembic_version'
          )
    LOOP
        EXECUTE format('DROP TABLE public.%I CASCADE', candidate.tablename);
    END LOOP;
END
$$;
